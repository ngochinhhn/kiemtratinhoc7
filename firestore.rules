rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mở toàn bộ quyền đọc và ghi cho các collection của hệ thống SMART TEST 7
    // để Giáo viên (đăng nhập admin hoặc Google) và Học sinh (đăng nhập mã nội bộ)
    // đồng bộ câu hỏi (questions/manual_...), đề thi, danh sách học sinh và nộp bài không bao giờ bị lỗi permission-denied.

    match /questions/{questionId} {
      allow read, write: if true;
    }

    match /exams/{examId} {
      allow read, write: if true;

      match /sessions/{sessionId} {
        allow read, write: if true;
      }
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    match /results/{resultId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
