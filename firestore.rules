rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL SAFETY NET (Default Deny)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. GLOBAL PRIMITIVE HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isTrustedOwnerId(ownerId) {
      return ownerId is string &&
             ownerId.size() >= 1 &&
             ownerId.size() <= 128 &&
             ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
             (ownerId == 'teacher_smarttest7' || (request.auth != null && ownerId == request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ngochinhhn@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // 2. VALIDATION BLUEPRINTS (Anti-Update-Gap & Schema Synchronicity)
    // =========================================================================
    function isValidAdminProfile(data) {
      return data.keys().hasAll(['ownerId', 'displayName', 'schoolName', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'displayName', 'schoolName', 'createdAt', 'updatedAt']) &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.ownerId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 200 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidQuestionItem(data) {
      return data.keys().hasAll([
               'id', 'ownerId', 'questionType', 'themeId', 'themeName',
               'lessonId', 'lessonName', 'content', 'cognitiveLevel',
               'reviewStatus', 'payloadMap', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerId', 'questionType', 'themeId', 'themeName',
               'lessonId', 'lessonName', 'content', 'cognitiveLevel',
               'reviewStatus', 'payloadMap', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             isTrustedOwnerId(data.ownerId) &&
             data.questionType is string && data.questionType.size() >= 4 && data.questionType.size() <= 32 &&
             (data.questionType == 'multiple_choice' || data.questionType == 'true_false' || data.questionType == 'matching') &&
             data.themeId is string && data.themeId.size() >= 1 && data.themeId.size() <= 64 &&
             data.themeName is string && data.themeName.size() >= 1 && data.themeName.size() <= 200 &&
             data.lessonId is string && data.lessonId.size() >= 1 && data.lessonId.size() <= 64 &&
             data.lessonName is string && data.lessonName.size() >= 1 && data.lessonName.size() <= 200 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
             data.cognitiveLevel is string && data.cognitiveLevel.size() >= 4 && data.cognitiveLevel.size() <= 32 &&
             (data.cognitiveLevel == 'nhan_biet' || data.cognitiveLevel == 'thong_hieu' || data.cognitiveLevel == 'van_dung' || data.cognitiveLevel == 'van_dung_cao') &&
             data.reviewStatus is string && data.reviewStatus.size() >= 4 && data.reviewStatus.size() <= 32 &&
             (data.reviewStatus == 'chua_kiem_duyet' || data.reviewStatus == 'da_kiem_duyet' || data.reviewStatus == 'can_chinh_sua') &&
             data.payloadMap is map && data.payloadMap.keys().size() <= 25 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidStudentRecord(data) {
      return data.keys().hasAll([
               'id', 'ownerId', 'fullName', 'normalizedName', 'loginCode',
               'className', 'latestScore', 'latestExamTitle', 'examScores',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerId', 'fullName', 'normalizedName', 'loginCode',
               'className', 'latestScore', 'latestExamTitle', 'examScores',
               'payloadMap', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             isTrustedOwnerId(data.ownerId) &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150 &&
             data.normalizedName is string && data.normalizedName.size() >= 1 && data.normalizedName.size() <= 150 &&
             data.loginCode is string && data.loginCode.size() >= 1 && data.loginCode.size() <= 64 && data.loginCode.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 32 &&
             (data.latestScore is int || data.latestScore is float) && data.latestScore >= -1 && data.latestScore <= 100 &&
             data.latestExamTitle is string && data.latestExamTitle.size() >= 0 && data.latestExamTitle.size() <= 250 &&
             data.examScores is map && data.examScores.keys().size() <= 100 &&
             (!('payloadMap' in data) || (data.payloadMap is map && data.payloadMap.keys().size() <= 20)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidExamDocument(data) {
      return data.keys().hasAll([
               'id', 'ownerId', 'title', 'examType', 'status',
               'durationMinutes', 'totalQuestions', 'maxScore',
               'classes', 'questionIds', 'allowReviewAfterSubmit',
               'shuffleQuestions', 'shuffleOptions', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerId', 'title', 'examType', 'status',
               'durationMinutes', 'totalQuestions', 'maxScore',
               'classes', 'questionIds', 'allowReviewAfterSubmit',
               'shuffleQuestions', 'shuffleOptions', 'payloadMap',
               'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             isTrustedOwnerId(data.ownerId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
             data.examType is string && data.examType.size() >= 4 && data.examType.size() <= 32 &&
             (data.examType == '15_phut' || data.examType == '45_phut' || data.examType == 'giua_ky' || data.examType == 'cuoi_ky' || data.examType == 'tu_chon') &&
             data.status is string && data.status.size() >= 4 && data.status.size() <= 32 &&
             (data.status == 'chua_mo' || data.status == 'dang_dien_ra' || data.status == 'tam_dung' || data.status == 'da_ket_thuc') &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 180 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 100 &&
             (data.maxScore is int || data.maxScore is float) && data.maxScore >= 1 && data.maxScore <= 100 &&
             data.classes is list && data.classes.size() >= 1 && data.classes.size() <= 30 &&
             data.classes[0] is string && data.classes[0].size() >= 1 && data.classes[0].size() <= 32 &&
             data.questionIds is list && data.questionIds.size() >= 1 && data.questionIds.size() <= 100 &&
             data.questionIds[0] is string && data.questionIds[0].size() >= 1 && data.questionIds[0].size() <= 128 &&
             data.allowReviewAfterSubmit is bool &&
             data.shuffleQuestions is bool &&
             data.shuffleOptions is bool &&
             (!('payloadMap' in data) || (data.payloadMap is map && data.payloadMap.keys().size() <= 20)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidExamSessionDocument(data, examId) {
      return data.keys().hasAll([
               'id', 'examId', 'studentId', 'ownerId', 'paperCode',
               'status', 'timeRemainingSeconds', 'currentQuestionIndex',
               'score', 'correctCount', 'wrongCount', 'unansweredCount',
               'answers', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'examId', 'studentId', 'ownerId', 'paperCode',
               'status', 'timeRemainingSeconds', 'currentQuestionIndex',
               'score', 'correctCount', 'wrongCount', 'unansweredCount',
               'answers', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 128 && data.examId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.examId == examId &&
             data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
             isTrustedOwnerId(data.ownerId) &&
             data.paperCode is string && data.paperCode.size() >= 1 && data.paperCode.size() <= 32 &&
             data.status is string && data.status.size() >= 4 && data.status.size() <= 32 &&
             (data.status == 'chua_dang_nhap' || data.status == 'da_dang_nhap' || data.status == 'dang_lam_bai' || data.status == 'da_nop_bai' || data.status == 'mat_ket_noi') &&
             data.timeRemainingSeconds is int && data.timeRemainingSeconds >= 0 && data.timeRemainingSeconds <= 10800 &&
             data.currentQuestionIndex is int && data.currentQuestionIndex >= 0 && data.currentQuestionIndex <= 100 &&
             (data.score is int || data.score is float) && data.score >= 0 && data.score <= 100 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100 &&
             data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 100 &&
             data.unansweredCount is int && data.unansweredCount >= 0 && data.unansweredCount <= 100 &&
             data.answers is map && data.answers.keys().size() <= 100 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidStudentSubmissionDocument(data) {
      return data.keys().hasAll([
               'id', 'ownerId', 'examId', 'examTitle', 'studentId', 'studentCode',
               'fullName', 'className', 'paperCode', 'score', 'correctCount',
               'wrongCount', 'unansweredCount', 'totalQuestions', 'durationSeconds',
               'timeRemainingSeconds', 'submittedAt', 'status', 'answers',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'ownerId', 'examId', 'examTitle', 'studentId', 'studentCode',
               'fullName', 'className', 'paperCode', 'score', 'correctCount',
               'wrongCount', 'unansweredCount', 'totalQuestions', 'durationSeconds',
               'timeRemainingSeconds', 'submittedAt', 'status', 'answers',
               'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             isTrustedOwnerId(data.ownerId) &&
             data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 128 && data.examId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.examTitle is string && data.examTitle.size() >= 1 && data.examTitle.size() <= 300 &&
             data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.studentCode is string && data.studentCode.size() >= 1 && data.studentCode.size() <= 64 && data.studentCode.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 32 &&
             data.paperCode is string && data.paperCode.size() >= 1 && data.paperCode.size() <= 32 &&
             (data.score is int || data.score is float) && data.score >= 0 && data.score <= 100 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100 &&
             data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 100 &&
             data.unansweredCount is int && data.unansweredCount >= 0 && data.unansweredCount <= 100 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 100 &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             data.timeRemainingSeconds is int && data.timeRemainingSeconds >= 0 && data.timeRemainingSeconds <= 86400 &&
             data.submittedAt is string && data.submittedAt.size() >= 1 && data.submittedAt.size() <= 64 &&
             data.status is string && data.status.size() >= 4 && data.status.size() <= 32 &&
             (data.status == 'dang_lam_bai' || data.status == 'da_nop_bai' || data.status == 'mat_ket_noi') &&
             data.answers is map && data.answers.keys().size() <= 100 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // =========================================================================
    // 3. COLLECTION RULES
    // =========================================================================

    // --- /admins/{adminId} ---
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
                       isValidId(adminId) &&
                       request.auth.uid == adminId &&
                       isValidAdminProfile(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       isBootstrappedAdmin();

      allow update: if isVerifiedUser() &&
                       isValidId(adminId) &&
                       isValidAdminProfile(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time && (
                         (request.auth.uid == adminId &&
                          isBootstrappedAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'schoolName', 'updatedAt'])) ||
                         isAdmin()
                       );

      allow delete: if isVerifiedUser() && isValidId(adminId) && isBootstrappedAdmin();
    }

    // --- /questions/{questionId} ---
    match /questions/{questionId} {
      allow get: if isValidId(questionId) && isTrustedOwnerId(existing().ownerId);
      allow list: if isTrustedOwnerId(resource.data.ownerId);

      allow create: if isValidId(questionId) &&
                       incoming().id == questionId &&
                       isValidQuestionItem(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isValidId(questionId) &&
                       isValidQuestionItem(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().ownerId == existing().ownerId &&
                       (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                       incoming().updatedAt == request.time;

      allow delete: if isValidId(questionId) && isTrustedOwnerId(existing().ownerId);
    }

    // --- /students/{studentId} ---
    match /students/{studentId} {
      allow get: if isValidId(studentId) && isTrustedOwnerId(existing().ownerId);
      allow list: if isTrustedOwnerId(resource.data.ownerId);

      allow create: if isValidId(studentId) &&
                       incoming().id == studentId &&
                       isValidStudentRecord(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isValidId(studentId) &&
                       isValidStudentRecord(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().ownerId == existing().ownerId &&
                       (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                       incoming().updatedAt == request.time;

      allow delete: if isValidId(studentId) && isTrustedOwnerId(existing().ownerId);
    }

    // --- /exams/{examId} ---
    match /exams/{examId} {
      allow get: if isValidId(examId) && isTrustedOwnerId(existing().ownerId);
      allow list: if isTrustedOwnerId(resource.data.ownerId);

      allow create: if isValidId(examId) &&
                       incoming().id == examId &&
                       isValidExamDocument(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isValidId(examId) &&
                       isValidExamDocument(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().ownerId == existing().ownerId &&
                       (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                       incoming().updatedAt == request.time;

      allow delete: if isValidId(examId) && isTrustedOwnerId(existing().ownerId);

      // --- Subcollection: /exams/{examId}/sessions/{sessionId} (Master Gate) ---
      match /sessions/{sessionId} {
        allow get: if isValidId(examId) &&
                      isValidId(sessionId) &&
                      exists(/databases/$(database)/documents/exams/$(examId)) &&
                      isTrustedOwnerId(existing().ownerId);

        allow list: if isTrustedOwnerId(resource.data.ownerId);

        allow create: if isValidId(examId) &&
                         isValidId(sessionId) &&
                         incoming().id == sessionId &&
                         isValidExamSessionDocument(incoming(), examId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time &&
                         exists(/databases/$(database)/documents/exams/$(examId));

        allow update: if isValidId(examId) &&
                         isValidId(sessionId) &&
                         isValidExamSessionDocument(incoming(), examId) &&
                         incoming().id == existing().id &&
                         incoming().examId == existing().examId &&
                         incoming().studentId == existing().studentId &&
                         incoming().ownerId == existing().ownerId &&
                         (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                         incoming().updatedAt == request.time &&
                         exists(/databases/$(database)/documents/exams/$(examId));

        allow delete: if isValidId(examId) &&
                         isValidId(sessionId) &&
                         exists(/databases/$(database)/documents/exams/$(examId)) &&
                         isTrustedOwnerId(existing().ownerId);
      }
    }

    // --- /submissions/{submissionId} ---
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isTrustedOwnerId(existing().ownerId);
      allow list: if isTrustedOwnerId(resource.data.ownerId);

      allow create: if isValidId(submissionId) &&
                       incoming().id == submissionId &&
                       isValidStudentSubmissionDocument(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isValidId(submissionId) &&
                       isValidStudentSubmissionDocument(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().ownerId == existing().ownerId &&
                       (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                       incoming().updatedAt == request.time;

      allow delete: if isValidId(submissionId) && isTrustedOwnerId(existing().ownerId);
    }
  }
}
